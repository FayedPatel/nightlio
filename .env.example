# Example environment for Nightlio
# Copy to `.env` at the repo root for backend and `.env.local` for frontend

# Backend (.env)
APP_ENV=development
PORT=5000
# Required: set a strong random value before deploying (never the same
# value as JWT_SECRET). Generate with: openssl rand -hex 32
SECRET_KEY=
# Required: set a strong random value before deploying (never the same
# value as SECRET_KEY). Generate with: openssl rand -hex 32
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173

# Feature flags (0=disabled, 1=enabled)
ENABLE_MOOD_MUSIC=0

# Self-host defaults
DEFAULT_SELF_HOST_ID=selfhost_default_user

# Database (optional; defaults to data/nightlio.db)
# DATABASE_PATH=

# OIDC single sign-on (optional; any OIDC-compliant provider works,
# Pocket ID is the recommended self-host option).
# Setting OIDC_ISSUER_URL enables SSO and (unless DISABLE_LOCAL_LOGIN=0 is
# set explicitly) disables local login entirely — see DISABLE_LOCAL_LOGIN.
# Discovery is derived as <OIDC_ISSUER_URL>/.well-known/openid-configuration
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional; defaults to <api>/api/auth/callback/oidc
# OIDC_CALLBACK_URL=
# Optional: signup/registration URL at your identity provider (for
# Pocket ID, its signup or invite link). When set and OIDC is enabled,
# the login page shows a "Create account" link pointing at it.
# Leave empty for no signup affordance.
# OIDC_SIGNUP_URL=
# Hard-disable local logins (1=disabled): POST /api/auth/local/login refuses
# both the username/password form and credential-free self-host mode.
# Default (unset/empty) follows OIDC: with OIDC_ISSUER_URL configured, local
# login is DISABLED; without OIDC it stays enabled. An explicit value always
# wins: 0 keeps local login alongside SSO, 1 disables it even without SSO.
# DISABLE_LOCAL_LOGIN=

# Mood music (only if ENABLE_MOOD_MUSIC=1)
JAMENDO_CLIENT_ID=

# Optional: only if the frontend is served from a different origin than the
# api (redirect target after OIDC login; unset means same-origin)
# FRONTEND_URL=

# Optional: set to 1 only if the api sits behind a trusted reverse proxy
# (real client IPs for rate limiting, correct Secure cookie flag behind TLS)
# TRUST_PROXY_HEADERS=0

# Frontend (.env.local)
VITE_API_URL=http://localhost:5000