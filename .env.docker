# Docker Environment Configuration for Nightlio
# Copy this file to .env in the project root to customize your deployment

# Security Settings -- REQUIRED, no default. docker compose refuses to
# start the api container until both are set (see docker-compose.yml); the
# api itself also refuses to start in production with a missing, blank, or
# well-known placeholder value here, so leaving the old
# "your-secret-key-change-this..." text in place is caught, not silently
# accepted. Use two DIFFERENT random values:
#   openssl rand -hex 32
SECRET_KEY=
JWT_SECRET=

# Feature Flags (0=disabled, 1=enabled)
ENABLE_MOOD_MUSIC=0

# Self-host Configuration
DEFAULT_SELF_HOST_ID=selfhost_default_user

# CORS Origins (update for production)
CORS_ORIGINS=http://localhost:5173,http://localhost:5000

# OIDC single sign-on (optional; any OIDC-compliant provider works, Pocket ID
# is the recommended self-host option: https://github.com/pocket-id/pocket-id).
# Leave all three empty for local-password/single-user auth (default).
# Setting OIDC_ISSUER_URL enables SSO and disables credential-free local login.
# Discovery is derived as <OIDC_ISSUER_URL>/.well-known/openid-configuration
# See docs/DOCKER.md for the Pocket ID compose profile and callback URL.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Hard-disable local logins entirely (1=disabled). When disabled,
# POST /api/auth/local/login refuses both the username/password form and
# credential-free self-host mode, so the identity provider is the only door.
# Default (unset/empty) follows OIDC: with OIDC_ISSUER_URL configured, local
# login is DISABLED (user management is delegated to the identity provider);
# without OIDC it stays enabled. An explicit value always wins: set 0 to keep
# local login alongside SSO, or 1 to disable it even without SSO.
# Warning: with OIDC unconfigured AND this set to 1, nobody can log in at all.
# DISABLE_LOCAL_LOGIN=

# Mood music settings (only needed if ENABLE_MOOD_MUSIC=1)
JAMENDO_CLIENT_ID=

# Database Path (defaults to volume mount in Docker)
# DATABASE_PATH=/app/data/nightlio.db

APP_ENV=production
# RAILWAY_ENVIRONMENT is deprecated (D5); APP_ENV is now the primary env
# selector. Still honored as a fallback if you have it set already, so
# existing deployments don't need to change anything -- new setups should
# use APP_ENV only.
# RAILWAY_ENVIRONMENT=production

# Cross-origin SSO redirect target (optional). Only needed if the frontend
# is served from a different origin than the api (e.g. a split
# frontend/api deployment). Empty/unset means same-origin (the standard
# single-host deployment where nginx serves both) -- leave unset otherwise.
# FRONTEND_URL=

# Trust X-Forwarded-For / X-Forwarded-Proto from a reverse proxy in front of
# the api (optional). Enables real client IPs in the rate limiter and lets
# the session cookie's Secure flag reflect the original request scheme.
# Only enable this if the api is actually behind a trusted reverse proxy.
# TRUST_PROXY_HEADERS=0

# Port Configuration (usually don't need to change)
# PORT=5000

# Pocket ID (only if using the oidc compose profile)
# Required by Pocket ID, >= 16 bytes: openssl rand -hex 32
POCKET_ID_ENCRYPTION_KEY=
# Defaults to http://pocket-id.localhost:1411 for local use; set to the
# public HTTPS URL (e.g. https://id.yourdomain.com) for a real deployment.
# POCKET_ID_APP_URL=
