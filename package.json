{
  "name": "nightlio",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "A beautiful, self-hosted daily mood tracker and journal",
  "author": "shirsakm",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/shirsakm/nightlio",
  "repository": {
    "type": "git",
    "url": "https://github.com/shirsakm/nightlio.git"
  },
  "bugs": {
    "url": "https://github.com/shirsakm/nightlio/issues"
  },
  "keywords": [
    "mood-tracker",
    "journal",
    "self-hosted",
    "privacy",
    "react",
    "typescript",
    "rust",
    "docker"
  ],
  "scripts": {
    "dev": "vite",
    "build": "export NODE_OPTIONS='--max-old-space-size=768'; tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "api": "cargo run --manifest-path api/Cargo.toml",
    "api:dev": "cargo run --manifest-path api/Cargo.toml",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "i18n:validate": "node scripts/validate-lang-pack.mjs",
    "i18n:build": "node scripts/build-lang-pack.mjs",
    "test": "cargo test --manifest-path api/Cargo.toml",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "cargo test --manifest-path api/Cargo.toml && vitest run && playwright test"
  },
  "dependencies": {
    "@mdxeditor/editor": "^3.11.6",
    "lucide-react": "^0.460.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.9.6",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.2.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4",
    "eslint": "^9.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26",
    "rollup-plugin-visualizer": "^6.0.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "resolutions": {
    "vite": "^7.1.0"
  }
}
