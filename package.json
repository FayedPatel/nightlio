{
  "name": "nightlio",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "A beautiful, self-hosted daily mood tracker and journal",
  "author": "shirsakm",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/shirsakm/nightlio",
  "repository": {
    "type": "git",
    "url": "https://github.com/shirsakm/nightlio.git"
  },
  "bugs": {
    "url": "https://github.com/shirsakm/nightlio/issues"
  },
  "keywords": [
    "mood-tracker",
    "journal",
    "self-hosted",
    "privacy",
    "react",
    "flask",
    "docker"
  ],
  "scripts": {
    "dev": "vite",
    "build": "NODE_OPTIONS='--max-old-space-size=768' vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "api": "cd api && python3 -m venv venv && venv/bin/pip install -r requirements.txt && venv/bin/flask run --no-debugger",
    "api:dev": "cd api && venv/bin/python start.py",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "test": "./test.sh",
    "test:api": "./test.sh",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "./test.sh && vitest run && playwright test"
  },
  "dependencies": {
    "@mdxeditor/editor": "^3.11.6",
    "@tanstack/react-query": "^5.85.3",
    "lucide-react": "^0.460.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.9.6",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4",
    "eslint": "^9.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26",
    "rollup-plugin-visualizer": "^6.0.5",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4"
  },
  "resolutions": {
    "vite": "^7.1.0"
  }
}
