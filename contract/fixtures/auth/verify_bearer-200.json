{
  "method": "POST",
  "path": "/api/auth/verify",
  "request": {
    "headers_that_matter": {
      "Authorization": "Bearer <JWT>"
    },
    "body": null
  },
  "response": {
    "status": 200,
    "content_type": "application/json",
    "body": {
      "user": {
        "avatar_url": null,
        "email": "selfhost_default_user@localhost",
        "id": 1,
        "name": "Me"
      }
    }
  },
  "notes": [
    "Bearer requests need no Content-Type and no CSRF header even though the method is POST.",
    "No Set-Cookie: verify never refreshes the cookie."
  ]
}
