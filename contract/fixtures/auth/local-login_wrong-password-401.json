{
  "method": "POST",
  "path": "/api/auth/local/login",
  "request": {
    "headers_that_matter": {
      "Content-Type": "application/json"
    },
    "body": {
      "username": "alice",
      "password": "wrongpassword"
    }
  },
  "response": {
    "status": 401,
    "content_type": "application/json",
    "body": {
      "error": "Invalid credentials"
    }
  },
  "notes": [
    "Same 401 body for unknown username, username with no stored hash, and wrong password -- deliberately indistinguishable.",
    "No Set-Cookie header on failure."
  ]
}
