{
  "method": "GET",
  "path": "/api/statistics/heatmap?year=abc",
  "request": {
    "headers_that_matter": {
      "Authorization": "Bearer <JWT>"
    },
    "body": null
  },
  "response": {
    "status": 400,
    "content_type": "application/json",
    "body": {
      "error": "year must be an integer"
    }
  },
  "notes": "Non-integer year -> 400. Out-of-range (<1970 or >2100) also 400."
}
