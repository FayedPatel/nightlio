{
  "method": "POST",
  "path": "/api/mood",
  "request": {
    "headers_that_matter": {
      "Authorization": "Bearer <JWT>",
      "Content-Type": "application/json"
    },
    "body": {
      "mood": 3,
      "date": "01-08-2025",
      "content": "x"
    }
  },
  "response": {
    "status": 400,
    "content_type": "application/json",
    "body": {
      "error": "date must be YYYY-MM-DD or M/D/YYYY"
    }
  },
  "notes": "Date must be YYYY-MM-DD or M/D/YYYY; future dates beyond today+1 day also 400."
}
