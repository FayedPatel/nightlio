{
  "method": "POST",
  "path": "/api/goals/1/progress",
  "request": {
    "headers_that_matter": {
      "Authorization": "Bearer <JWT>",
      "Content-Type": "application/json"
    },
    "body": {
      "date": "2026-08-13"
    }
  },
  "response": {
    "status": 200,
    "content_type": "application/json",
    "body": {
      "already_completed_today": true,
      "already_logged": false,
      "completed": 2,
      "created_at": "<TS>",
      "description": "15 minutes",
      "frequency_per_week": 4,
      "id": 1,
      "last_completed_date": "<DATE>",
      "logged_date": "<DATE>",
      "period_start": "<DATE>",
      "streak": 0,
      "title": "Meditate more",
      "updated_at": "<TS>",
      "user_id": 1
    }
  },
  "notes": "Optional body {date} backdates a completion (recorded with date=2026-08-13, 2 days before run date; request body date normalized to <DATE> would lose meaning so it is kept literal). Response logged_date echoes it (normalized)."
}
