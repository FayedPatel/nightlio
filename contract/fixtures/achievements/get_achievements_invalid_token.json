{
  "method": "GET",
  "path": "/api/achievements",
  "request": {
    "headers_that_matter": {
      "Authorization": "Bearer <JWT>"
    },
    "body": null
  },
  "response": {
    "status": 401,
    "content_type": "application/json",
    "body": {
      "error": "Invalid token"
    }
  },
  "notes": "Malformed/unsigned JWT -> 401 {\"error\": \"Invalid token\"}. An expired token instead yields {\"error\": \"Token expired\"}."
}
