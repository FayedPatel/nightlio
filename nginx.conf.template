server {
    listen ${PORT};
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/xml+rss application/json;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Handle client-side routing
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy API requests to backend
    location /api/ {
        # Explicit cap rather than relying on nginx's implicit 1m default:
        # the api has no per-endpoint body-size limits of its own, so an
        # authenticated client could otherwise post arbitrarily large
        # bodies (e.g. mood entry text) repeatedly and fill disk. Mirrors
        # gunicorn's own header/line limits added in api/docker_start.py.
        client_max_body_size 1m;

        proxy_pass ${API_URL};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        # $http_host keeps the port (:5173); $host strips it, which breaks
        # externally generated URLs like the OIDC callback redirect_uri.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Preserve the original scheme from an upstream TLS terminator
        # (e.g. caddy); fall back to our own scheme when hit directly.
        set $xfp $http_x_forwarded_proto;
        if ($xfp = '') {
            set $xfp $scheme;
        }
        proxy_set_header X-Forwarded-Proto $xfp;
        proxy_cache_bypass $http_upgrade;

        # Without explicit timeouts a client can hold a connection to the
        # api open indefinitely (slowloris-style), tying up one of the 4
        # gunicorn sync workers per open connection. connect/send stay
        # tight; read is a little longer for slower endpoints (PDF export).
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Deploy-critical files must always revalidate. Exact-match (=) locations
    # beat the regex block below regardless of order, so sw.js escapes the
    # 1y-immutable rule that would otherwise pin browsers to a stale service
    # worker (and with it, a stale app shell) for a year. nginx's default
    # `etag on` makes each revalidation a cheap 304. add_header here
    # intentionally mirrors the static block below: like it, these blocks
    # define their own add_header and therefore do not inherit the
    # server-level security headers.
    location = /sw.js {
        add_header Cache-Control "no-cache";
    }
    location = /manifest.webmanifest {
        add_header Cache-Control "no-cache";
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Cache static assets (hashed /assets/* filenames make immutable safe)
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Security: deny access to hidden files
    location ~ /\. {
        deny all;
    }
}
