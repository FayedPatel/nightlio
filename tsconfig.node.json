{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["node"],

    /* Migration complete: no .js/.jsx sources remain. */
    "allowJs": false,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true
  },
  /* eslint.config.js stays .js (flat config); with allowJs off it is no longer
     part of any project, which loses nothing — allowJs without checkJs never
     type-checked it anyway. */
  "include": ["vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
