# api build context (docker-compose.yml api service: context ./api).
#
# target/ is a debug+release build cache that can reach multiple GB locally;
# without this file every `docker build` sends it to the daemon as part of
# the build context (slow, and irrelevant -- the Dockerfile builds fresh
# inside the container anyway, it never reads the host's target/).
target/

# VCS / editor / OS cruft that has no business inside the image.
.git/
.gitignore
*.swp
*.swo
.DS_Store

# Docker files themselves don't need to be in their own build context.
Dockerfile
.dockerignore
